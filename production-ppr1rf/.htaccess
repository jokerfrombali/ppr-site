# Сгенерировано build.py. Apache 2.4+
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
# Убрать www и перевести на https
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 301 со старых адресов на новую структуру
Redirect 301 /index.html /
Redirect 301 /pprk.html /pprk/
Redirect 301 /oati-order.html /oati/ppr-dlya-ordera/
Redirect 301 /price-list.html /ceny/
Redirect 301 /primer.html /primery-ppr/
Redirect 301 /faq.html /faq/
Redirect 301 /contacts.html /kontakty/
Redirect 301 /ppr-po-razdelam/ppr_visota.html /ppr/raboty-na-vysote/
Redirect 301 /ppr-po-razdelam/ppr-na-krovlu.html /ppr/krovlya/
Redirect 301 /ppr-po-razdelam/ppr-na-montazh-metallokonstrukcij.html /ppr/montazh-metallokonstrukcij/
Redirect 301 /ppr-po-razdelam/ppr-na-demontazh.html /ppr/demontazh/
Redirect 301 /ppr-po-razdelam/ppr-na-seti.html /ppr/naruzhnye-seti/
Redirect 301 /ppr-po-razdelam/ppr-na-otdelku.html /ppr/otdelochnye-raboty/
Redirect 301 /ppr-po-razdelam/ppr_zemlyanie_raboty.html /ppr/zemlyanye-raboty/
Redirect 301 /ppr-po-razdelam/ppr_fundament.html /ppr/fundament/
Redirect 301 /ppr-po-razdelam/ppr-na-fasad.html /ppr/fasadnye-raboty/
Redirect 301 /ppr-po-razdelam/ppr-na-kladku.html /ppr/kamennye-raboty/
Redirect 301 /ppr-po-razdelam/ppr_motolit.html /ppr/betonnye-raboty/monolitnye-konstrukcii/
Redirect 301 /ppr-po-razdelam/ppr-na-elektromontazh.html /ppr/elektromontazhnye-raboty/
Redirect 301 /ppr-po-razdelam/ppr-na-stroitelnye-lesa.html /ppr/stroitelnye-lesa/
Redirect 301 /ppr-po-razdelam/ppr_avtodoroga.html /ppr/avtodorogi/
Redirect 301 /ppr-po-razdelam/ppr-na-montazh-okon.html /ppr/okna-vitrazhi/
Redirect 301 /podval/politic.html /politika-konfidencialnosti/
Redirect 301 /podval/soglasie.html /soglasie-na-obrabotku/

# Слеш в конце адреса
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(/$|\.)
RewriteRule (.*) %{REQUEST_URI}/ [R=301,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
